# Backend
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost

# Auth security
LOGIN_MAX_FAILURES=5
LOGIN_FAIL_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
AUTO_MIGRATE_LEGACY_PASSWORDS=true

# AI provider
NVIDIA_OPENAI_BASE_URL=https://api.deepseek.com
NVIDIA_API_KEY=
NVIDIA_OPENAI_COMPLETIONS_PATH=/chat/completions
NVIDIA_MODEL=deepseek-chat
NVIDIA_TEMPERATURE=0.2
NVIDIA_MAX_TOKENS=4096

# Database
MYSQL_URL=jdbc:mysql://localhost:3306/mianshitong?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Docker MySQL root password
MYSQL_ROOT_PASSWORD=
